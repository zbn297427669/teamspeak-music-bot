# TSMusicBot — 【仅 WSL → Windows 桥接】部署配置（示例）
#
# 用途：git 在 WSL、bot 跑在另一个 Windows 目录时用。
# 迁到独立 Linux 服务器 / 纯 Docker 时：不要复制本文件，整份可忽略。
#   Linux 服务器请用 scripts/install.sh（systemd）或 scripts/docker/
#
# 复制为同目录下的 deploy.windows.env 后按需修改：
#   cp deploy.windows.env.example deploy.windows.env
#
# deploy.windows.env 已加入 .gitignore，不会提交到 git。
# 也可用环境变量覆盖本文件中的同名项。

# Windows 上实际运行 bot 的目录（可与 WSL 仓库路径/文件夹名不同）
# 支持两种写法：
#   WSL 挂载路径: /mnt/d/bots/tsmusicbot-runtime
#   Windows 路径:  D:\bots\tsmusicbot-runtime
TSMB_WIN_DIR=/mnt/d/bots/teamspeak-music-bot

# 任务计划程序中的任务名（开机自启用的那个）
TSMB_TASK_NAME=TSMusicBot

# 可选：systemd 名（仅「本机 Linux 跑 bot」时给 stop.sh/update.sh 用；
# WSL→Windows 分离部署可忽略。真正 Linux 服务器也可用环境变量，不必靠本文件。）
# TSMB_SERVICE_NAME=tsmusicbot

# 可选开关（1=开启，留空或 0=关闭）——下列主要影响 Windows update.bat
# TSMB_FULL_SETUP=0      # 强制完整 setup.bat
# TSMB_SKIP_PULL=0       # 跳过 git pull
# TSMB_NO_START=0        # 更新后不自动启动任务
# TSMB_SYNC_DELETE=0     # 同步时删除 Windows 上已从仓库移除的文件
